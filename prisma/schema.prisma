// این فایل فقط مستندات ساختاری دیتابیس است و در Runtime استفاده نمی‌شود.
// دسترسی فعلی برنامه به MongoDB فقط با Native Driver انجام می‌شود.

datasource db {
  provider = "mongodb"
}

enum UserRole {
  SuperAdmin
  Manager
  Staff
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  ABANDONED
  CONVERTED
}

enum OrderStatus {
  PENDING
  PROCESSING
  READY
  DELIVERED
  CANCELLED
}

enum DeliveryType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum WaiterCallStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String        @unique
  phone        String?       @unique
  passwordHash String
  role         UserRole
  isActive     Boolean       @default(true)
  carts        Cart[]
  orders       Order[]
  waiterCalls  WaiterCall[]
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("users")
}

model Category {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  name          String
  slug          String     @unique
  description   String?
  parentId      String?    @db.ObjectId
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  scheduledFrom DateTime?
  scheduledTo   DateTime?
  scheduleDays  Int[]
  items         MenuItem[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@map("menu_categories")
}

model MenuItem {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  slug            String      @unique
  description     String?
  price           Float
  currency        String      @default("IRR")
  imageUrl        String?
  categoryId      String      @db.ObjectId
  category        Category    @relation(fields: [categoryId], references: [id])
  inStock         Boolean     @default(true)
  isFeatured      Boolean     @default(false)
  isActive        Boolean     @default(true)
  preparationTime Int?
  tags            String[]
  orderItems      OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([categoryId])
  @@index([isActive, inStock])
  @@map("menu_items")
}

model Table {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  number       Int           @unique
  token        String        @unique
  capacity     Int           @default(2)
  isActive     Boolean       @default(true)
  carts        Cart[]
  orders       Order[]
  reservations Reservation[]
  waiterCalls  WaiterCall[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("tables")
}

model WaiterCall {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  tableId   String           @db.ObjectId
  table     Table            @relation(fields: [tableId], references: [id])
  userId    String?          @db.ObjectId
  user      User?            @relation(fields: [userId], references: [id])
  status    WaiterCallStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tableId, status])
  @@map("waiter_calls")
}

model Reservation {
  id         String            @id @default(auto()) @map("_id") @db.ObjectId
  tableId    String            @db.ObjectId
  table      Table             @relation(fields: [tableId], references: [id])
  guestName  String
  guestPhone String
  guestCount Int               @default(1)
  startTime  DateTime
  endTime    DateTime
  status     ReservationStatus @default(PENDING)
  notes      String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  @@index([tableId, startTime])
  @@index([startTime, endTime])
  @@map("reservations")
}

model Cart {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?    @db.ObjectId
  user      User?      @relation(fields: [userId], references: [id])
  tableId   String?    @db.ObjectId
  table     Table?     @relation(fields: [tableId], references: [id])
  status    CartStatus @default(ACTIVE)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([userId, status])
  @@index([tableId, status])
  @@map("carts")
}

model CartItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  cartId     String   @db.ObjectId
  cart       Cart     @relation(fields: [cartId], references: [id])
  menuItemId String   @db.ObjectId
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int
  currency   String   @default("IRR")
  createdAt  DateTime @default(now())

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model Order {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  userId       String?      @db.ObjectId
  user         User?        @relation(fields: [userId], references: [id])
  tableId      String?      @db.ObjectId
  table        Table?       @relation(fields: [tableId], references: [id])
  items        OrderItem[]
  status       OrderStatus  @default(PENDING)
  subtotal     Float        @default(0)
  discount     Float        @default(0)
  total        Float        @default(0)
  currency     String       @default("IRR")
  notes        String?
  deliveryType DeliveryType @default(DINE_IN)
  payments     Payment[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId, createdAt])
  @@index([tableId, createdAt])
  @@index([status, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String   @db.ObjectId
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  name       String
  price      Float
  quantity   Int
  currency   String   @default("IRR")
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String        @db.ObjectId
  order     Order         @relation(fields: [orderId], references: [id])
  provider  String
  amount    Float
  currency  String        @default("IRR")
  authority String
  refId     String?
  status    PaymentStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([orderId])
  @@index([authority])
  @@map("payments")
}

model Setting {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  siteName       String
  logoUrl        String?
  primaryColor   String   @default("#2f6b4f")
  secondaryColor String   @default("#8b233d")
  accentColor    String   @default("#f4e3b2")
  themeMode      String   @default("system")
  contactPhone   String?
  contactEmail   String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("settings")
}

model Purchase {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  amount      Float
  currency    String   @default("IRR")
  purchasedAt DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([purchasedAt])
  @@map("purchases")
}

model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  amount      Float
  currency    String   @default("IRR")
  spentAt     DateTime
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spentAt])
  @@map("expenses")
}

model MediaAsset {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fileName  String
  url       String
  mimeType  String
  size      Int
  ownerType String
  ownerId   String
  createdAt DateTime @default(now())

  @@index([ownerType, ownerId])
  @@map("media_assets")
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  actorId   String?  @db.ObjectId
  actor     User?    @relation(fields: [actorId], references: [id])
  details   Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@map("audit_logs")
}
